# Copy this file to backend/.env and fill in your own values.

DJANGO_SECRET_KEY=change-me-to-something-random
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEYS=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash

# Maximum wait between response bytes; connection timeout is 5 seconds.
GEMINI_READ_TIMEOUT=30

# Local development prints email to the backend console.
# For real delivery use django.core.mail.backends.smtp.EmailBackend and your provider's settings.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Memento <noreply@example.com>
